{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug iOS (Expo)",
      "request": "launch",
      "type": "reactnative",
      "platform": "ios",
      "target": "simulator",
      "expo": true,
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Attach to Hermes (Expo)",
      "request": "attach",
      "type": "reactnative",
      "cwd": "${workspaceFolder}",
      "useHermesEngine": true,
      "sourceMaps": true,
      "expo": true
    }
  ]
}



