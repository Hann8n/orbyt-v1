{
  "expo": {
    "name": "orbyt",
    "slug": "byte-app",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.getorbyt.app",
      "buildNumber": "19",
      "icon": "./src/assets/AppIcons/iOS/orbyt.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "This app needs access to your camera to take photos and record videos",
        "NSMicrophoneUsageDescription": "This app needs access to your microphone for recording videos with sound",
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library to select profile pictures and share photos",
        "NSPhotoLibraryAddUsageDescription": "This app needs permission to save photos to your photo library",
        "LSApplicationQueriesSchemes": ["mailto"]
      }
    },
    "scheme": "com.getorbyt",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/AppIcons/android/orbyt_icon_adaptive_foreground.png",
        "backgroundColor": "#000000"
      },
      "package": "com.orbyt.app",
      "versionCode": 19,
      "permissions": ["CAMERA", "RECORD_AUDIO"]
    },
    "web": {
      "favicon": "./src/assets/favicon.png"
    },
    "splash": {
      "image": "./src/assets/icon-with-padding.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "plugins": [
      [
        "expo-font",
        {
          "fonts": [
            "./src/assets/fonts/Figtree-Regular.ttf",
            "./src/assets/fonts/Figtree-Medium.ttf",
            "./src/assets/fonts/Figtree-SemiBold.ttf",
            "./src/assets/fonts/Figtree-Bold.ttf",
            "./src/assets/fonts/Figtree-BoldItalic.ttf",
            "./src/assets/fonts/Figtree-Black.ttf"
          ]
        }
      ],
      [
        "@mozzius/expo-dynamic-app-icon",
        {
          "orBYTE": {
            "ios": "./src/assets/AppIcons/iOS/orBYTE.png",
            "android": "./src/assets/AppIcons/android/orBYTE_foreground.png",
            "prerendered": true
          },
          "orbytTV": {
            "ios": "./src/assets/AppIcons/iOS/orbyt.png",
            "android": "./src/assets/AppIcons/android/orbyt_icon_adaptive_foreground.png",
            "prerendered": true
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera",
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "This app needs access to your photo library to select profile pictures and share photos.",
          "cameraPermission": "This app needs access to your camera to take photos for your profile picture."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          },
          "android": {
            "targetSdkVersion": 36,
            "packagingOptions": {
              "pickFirsts": ["builddef.lst", "**/builddef.lst"],
              "excludes": ["builddef.lst", "**/builddef.lst"]
            }
          }
        }
      ],
      "expo-asset",
      "expo-background-task",
      "expo-secure-store",
      "expo-web-browser",
      "expo-router",
      [
        "./ffmpeg-kit-plugin.js",
        {
          "iosUrl": "https://github.com/NooruddinLakhani/ffmpeg-kit-ios-full-gpl/archive/refs/tags/latest.zip",
          "androidLocalPath": "./patches/ffmpeg-kit-full-gpl.aar"
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      [
        "expo-navigation-bar",
        {
          "backgroundColor": "#000000",
          "barStyle": "light"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "67a8dfaf-4d9a-4d5d-bf99-1df4e4619bc8"
      },
      "updateVersion": "2026.01.16.6"
    },
    "owner": "orbyt",
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/67a8dfaf-4d9a-4d5d-bf99-1df4e4619bc8"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
