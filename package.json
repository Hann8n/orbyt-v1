    "@react-navigation/native-stack": "^7.3.16",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "^5.90.20",
    "abortcontroller-polyfill": "^1.7.8",
    "buffer": "^6.0.3",
    "date-fns": "^4.1.0",
    "event-target-polyfill": "^0.0.4",
    "expo": "~54.0.32",
