{
  "name": "orbyt",
  "version": "1.1.0",
  "main": "index.ts",
  "license": "GPL-3.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "postinstall": "patch-package && pod-install",
    "build:dev": "eas build --profile development",
    "build:preview": "eas build --profile preview",
    "build:prod": "eas build --profile production",
    "build:ios-ipa": "eas build --platform ios --profile ios-ipa",
    "build:android-apk": "bash scripts/ensure-android-keystore-props.sh && cd android && ./gradlew assembleRelease",
    "build:ios": "bash scripts/build-all.sh ios",
    "build:android": "bash scripts/build-all.sh android",
    "build:all": "bash scripts/build-all.sh",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "check": "yarn type-check && yarn lint && yarn format:check",
    "serve:docs": "npx serve docs -l 5173 --single",
    "prepare": "husky",
    "version:increment": "npx tsx scripts/update-version.ts increment",
    "version:reset": "npx tsx scripts/update-version.ts reset",
    "version:get": "npx tsx scripts/update-version.ts get",
    "update": "yarn version:increment && npx eas-cli update --channel production --message",
    "update:preview": "yarn version:increment && npx eas-cli update --channel preview --message",
    "update:development": "yarn version:increment && npx eas-cli update --channel development --message",
    "update:all": "npx tsx scripts/push-update-all-channels.ts",
    "create:sprite-sheet": "npx tsx scripts/create-sprite-sheet.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:reassure": "npx reassure",
    "test:reassure:baseline": "npx reassure --baseline"
  },
  "dependencies": {
    "@atproto/api": "^0.18.16",
    "@atproto/oauth-client": "^0.5.3",
