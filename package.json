{
  "name": "orbyt-app",
  "version": "1.1.2",
  "main": "index.ts",
  "license": "GPL-3.0",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "postinstall": "patch-package && SKIP_SKIA_TVOS=1 node node_modules/@shopify/react-native-skia/scripts/install-skia.mjs && pod-install",
    "build:dev": "eas build --profile development",
    "build:preview": "eas build --profile preview",
    "build:prod": "eas build --profile production",
    "build:ios-ipa": "eas build --platform ios --profile ios-ipa",
    "build:android-apk": "bash scripts/ensure-android-keystore-props.sh && cd android && ./gradlew assembleRelease",
    "build:ios": "bash scripts/build-all.sh ios",
    "build:android": "bash scripts/build-all.sh android",
    "build:all": "bash scripts/build-all.sh",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "check": "yarn type-check && yarn lint && yarn format:check",
    "knip": "knip",
    "serve:docs": "npx serve docs -l 5173 --single",
    "prepare": "husky",
    "version:increment-build": "npx tsx scripts/update-version.ts increment-build",
    "version:get-build": "npx tsx scripts/update-version.ts get-build",
    "altstore:register": "bash scripts/altstore-pal.sh register",
    "altstore:process": "bash scripts/altstore-pal.sh process",
    "altstore:status": "bash scripts/altstore-pal.sh status",
    "altstore:download": "bash scripts/altstore-pal.sh download"
  },
  "dependencies": {
    "@atproto/api": "^0.18.21",
    "@atproto/common-web": "^0.4.19",
    "@atproto/lexicon": "^0.6.2",
    "@atproto/oauth-client": "^0.5.14",
    "@atproto/oauth-client-expo": "^0.0.9",
    "@atproto/xrpc": "^0.7.7",
    "@babel/runtime": "^7.28.6",
    "@expo/dom-webview": "~55.0.3",
    "@expo/log-box": "55.0.8",
    "@expo/metro-runtime": "~55.0.7",
