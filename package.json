{
  "name": "orbyt-app",
  "version": "1.1.6",
  "main": "index.ts",
  "license": "GPL-3.0",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "postinstall": "patch-package && node node_modules/@shopify/react-native-skia/scripts/install-libs.js && pod-install",
    "build:dev": "eas build --profile development",
    "build:preview": "eas build --profile preview",
    "build:prod": "eas build --profile production",
    "build:ios-ipa": "eas build --platform ios --profile ios-ipa",
    "build:android-apk": "bash scripts/ensure-android-keystore-props.sh && cd android && ./gradlew assembleRelease",
    "build:ios": "bash scripts/build-all.sh ios",
    "build:android": "bash scripts/build-all.sh android",
    "build:all": "bash scripts/build-all.sh",
    "icons:build": "npx react-native-nano-icons --path ./.nanoicons.json",
    "type-check": "tsc --noEmit",
    "doctor": "expo-doctor",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "check": "yarn doctor && yarn type-check && yarn deps:knip && yarn lint && yarn format:check",
    "deps:knip": "knip",
    "analyze:deps": "npx @e18e/cli analyze",
    "serve:docs": "npx serve docs -l 5173 --single",
    "prepare": "husky",
    "version:increment-build": "npx tsx scripts/update-version.ts increment-build",
    "version:get-build": "npx tsx scripts/update-version.ts get-build",
    "altstore:register": "bash scripts/altstore-pal.sh register",
    "altstore:process": "bash scripts/altstore-pal.sh process",
    "altstore:status": "bash scripts/altstore-pal.sh status",
    "altstore:download": "bash scripts/altstore-pal.sh download",
    "assets:recolor-gradients": "npx tsx scripts/recolor-orbyt-gradient-pngs.ts",
    "test": "jest"
  },
  "dependencies": {
    "@atproto/api": "^0.19.18",
    "@atproto/lexicon": "^0.6.2",
    "@atproto/syntax": "^0.5.4",
    "@babel/runtime": "^7.28.6",
    "@expo/dom-webview": "~56.0.5",
    "@expo/log-box": "^56.0.12",
    "@expo/metro-runtime": "~56.0.12",
    "@formatjs/intl-segmenter": "^12.1.0",
    "@lodev09/react-native-true-sheet": "^3.8.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-firebase/analytics": "^24.0.0",
    "@react-native-firebase/app": "^24.0.0",
    "@react-native-menu/menu": "^2.0.0",
    "@react-native/metro-config": "^0.76.0",
    "@sentry/react-native": "~7.11.0",
    "@shopify/flash-list": "2.3.1",
    "@shopify/react-native-skia": "2.6.2",
    "@tanstack/react-query": "^5.90.21",
    "@variant-systems/expo-dynamic-app-icon": "^1.0.2",
    "abortcontroller-polyfill": "^1.7.8",
    "buffer": "^6.0.3",
    "core-js": "^3.49.0",
    "date-fns": "^4.1.0",
    "event-target-polyfill": "^0.0.4",
    "expo": "~56.0.4",
    "expo-application": "~56.0.3",
    "expo-asset": "~56.0.14",
    "expo-background-task": "~56.0.14",
    "expo-blur": "~56.0.3",
    "expo-build-properties": "~56.0.14",
    "expo-clipboard": "~56.0.3",
    "expo-constants": "~56.0.15",
    "expo-crypto": "~56.0.5",
    "expo-device": "~56.0.4",
    "expo-file-system": "~56.0.7",
    "expo-font": "~56.0.5",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.9",
    "expo-image-and-video-compressor": "^1.0.1",
    "expo-image-picker": "~56.0.13",
    "expo-insights": "~56.0.13",
    "expo-linking": "~56.0.11",
    "expo-localization": "~56.0.6",
    "expo-media-library": "~56.0.6",
    "expo-navigation-bar": "~56.0.3",
    "expo-network": "~56.0.4",
    "expo-router": "~56.2.6",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "expo-updates": "~56.0.16",
    "expo-video": "~56.1.2",
    "expo-video-thumbnails": "~56.0.3",
    "expo-web-browser": "~56.0.5",
    "ffmpeg-kit-react-native": "6.0.2",
    "i18next": "^25.8.18",
    "multiformats": "^9.9.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^16.5.8",
    "react-native": "0.85.3",
    "react-native-clip-trim": "^6.1.0-beta.1",
    "react-native-fast-video-merge": "file:packages/react-native-fast-video-merge",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-keyboard-controller": "1.21.7",
    "react-native-mmkv": "3.3.3",
    "react-native-nano-icons": "^0.1.8",
    "react-native-nitro-image": "^0.13.1",
    "react-native-nitro-modules": "^0.35.4",
    "react-native-pager-view": "8.0.1",
    "react-native-reanimated": "4.3.1",
    "react-native-resquircle": "^1.0.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-tab-view": "^4.3.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-vision-camera": "5.0.6",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.8.3",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@babel/core": "^7.28.6",
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@eslint/js": "^9.39.4",
    "@react-native/jest-preset": "^0.85.3",
    "@types/jest": "29.5.14",
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.14",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-plugin-react-compiler": "^19.1.0-rc.2",
    "babel-preset-expo": "~56.0.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-react-perf": "^3.3.3",
    "expo-doctor": "^1.18.18",
    "husky": "^9.1.7",
    "jest": "~29.7.0",
    "jest-expo": "~56.0.4",
    "knip": "^6.1.0",
    "lint-staged": "^16.2.7",
    "patch-package": "^8.0.0",
    "pod-install": "^1.0.7",
    "prettier": "^3.8.1",
    "react-refresh": "^0.18.0",
    "serve": "^14.2.4",
    "sharp": "^0.33.5",
    "typescript": "~6.0.3"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo/node",
    "testMatch": [
      "**/__tests__/**/*.test.ts?(x)"
    ],
    "moduleNameMapper": {
      "^react-native-mmkv$": "<rootDir>/src/__mocks__/react-native-mmkv.ts"
    }
  },
  "resolutions": {
    "expo-web-browser": "~56.0.5"
  },
  "expo": {
    "install": {
      "exclude": [
        "@shopify/flash-list",
        "react-native-keyboard-controller"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false,
        "exclude": [
          "@atproto/oauth-client-expo",
          "react-native-emoji-chooser",
          "react-native-nitro-image"
        ]
      }
    }
  },
  "packageManager": "yarn@4.15.0",
  "reanimated": {
    "staticFeatureFlags": {
      "USE_COMMIT_HOOK_ONLY_FOR_REACT_COMMITS": true,
      "IOS_SYNCHRONOUSLY_UPDATE_UI_PROPS": true
    }
  }
}
