    "expo-media-library": "~55.0.2",
    "expo-navigation-bar": "~55.0.2",
    "expo-router": "~55.0.0-beta.3",
    "expo-secure-store": "~55.0.2",
    "expo-splash-screen": "~55.0.2",
    "expo-updates": "~55.0.4",
    "expo-video": "~55.0.2",
    "expo-web-browser": "~55.0.2",
    "ffmpeg-kit-react-native": "6.0.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.1",
    "react-native-clip-trim": "^6.1.0-beta.1",
    "react-native-compressor": "^1.16.0",
