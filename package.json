  "devDependencies": {
    "@babel/core": "^7.28.6",
    "@types/node": "*",
    "@types/react": "~19.1.10",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "~54.0.10",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-native": "^5.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "patch-package": "^8.0.0",
    "pod-install": "^1.0.7",
    "prettier": "^3.8.1",
    "prop-types": "^15.8.1",
    "puppeteer": "^24.36.0",
    "serve": "^14.2.4",
    "sharp": "^0.34.5",
    "typescript": "~5.9.2"
  },
  "private": true,
  "resolutions": {
    "react": "19.1.0"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false,
        "exclude": [
          "@atproto/oauth-client-expo"
        ]
      }
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
