    "@tanstack/react-query": "^5.90.20",
    "abortcontroller-polyfill": "^1.7.8",
    "buffer": "^6.0.3",
    "date-fns": "^4.1.0",
    "event-target-polyfill": "^0.0.4",
    "expo": "~55.0.0-preview.7",
    "expo-background-task": "~55.0.2",
    "expo-blur": "~55.0.2",
    "expo-build-properties": "~55.0.3",
    "expo-camera": "~55.0.2",
    "expo-clipboard": "~55.0.2",
