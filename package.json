    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@babel/core": "^7.28.6",
    "@testing-library/react-native": "14.0.0-beta.0",
    "@types/jest": "29.5.14",
    "@types/node": "*",
    "@types/react": "~19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "~55.0.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-native": "^5.0.0",
    "husky": "^9.1.7",
    "jest": "~29.7.0",
    "jest-expo": "~55.0.4",
    "lint-staged": "^16.2.7",
    "patch-package": "^8.0.0",
    "pod-install": "^1.0.7",
    "prettier": "^3.8.1",
    "reassure": "^1.4.0",
    "serve": "^14.2.4",
    "sharp": "^0.34.5",
    "test-renderer": "^0.14.0",
    "typescript": "~5.9.2"
  },
  "private": true,
  "resolutions": {
    "react": "19.2.0",
    "@react-navigation/native": "7.1.28",
    "@react-navigation/core": "7.14.0",
    "expo-web-browser": "~55.0.2",
    "@expo/log-box": "55.0.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false,
        "exclude": [
          "@atproto/oauth-client-expo"
        ]
      }
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
