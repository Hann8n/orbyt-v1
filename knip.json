{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "project": ["app/**/*.{ts,tsx}", "src/**/*.{ts,tsx}"],
  "ignoreFiles": ["**/*.test.ts"],
  "ignore": ["src/**/index.ts"],
  "ignoreDependencies": ["buffer", "@react-navigation/core"],
  "ignoreBinaries": ["eas", "tsx"],
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },
  "ignoreIssues": {
    "src/context/FollowContext.tsx": ["exports"],
    "src/services/api/types.ts": ["types"],
    "src/utils/components/truesheet/KeyboardAwareFooter.tsx": ["exports"],
    "src/components/features/explore/ExploreScreen.tsx": ["exports"],
    "src/components/features/profile/ProfileImageViewerScreen.tsx": ["exports"],
    "src/components/screens/FeedModalTabScreen.tsx": ["exports"],
    "src/components/screens/FullHeightVideoTabScreen.tsx": ["exports"]
  }
}
