      "titleFontSize": 28,
      "descriptionFontFamily": "Firma-SemiBold",
      "descriptionFontSize": 16,
      "titleOpacity": 1,
      "descriptionOpacity": 0.9,
      "textOrder": "title-first"
    }
  },
