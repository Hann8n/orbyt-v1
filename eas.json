{
  "cli": {
    "version": ">=16.17.4",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "corepack": true,
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_PUBLIC_APP_CONFIG": "app.dev.json"
      }
    },
    "preview": {
      "corepack": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_CONFIG": "app.dev.json"
      }
    },
    "production": {
      "corepack": true,
      "autoIncrement": true,
      "distribution": "store",
      "env": {
        "EXPO_PUBLIC_APP_CONFIG": "app.prod.json"
      }
    },
    "ios-simulator": {
      "corepack": true,
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "ios-ipa": {
      "corepack": true,
      "extends": "preview",
      "ios": {
        "distribution": "internal",
        "buildConfiguration": "Release"
      }
    },
    "beta": {
      "corepack": true,
      "extends": "production",
      "distribution": "store",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_APP_CONFIG": "app.prod.json"
      }
    },
    "beta-apk": {
      "corepack": true,
      "extends": "production",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_CONFIG": "app.prod.json"
      }
    }
  },
  "submit": {
    "production": {},
    "beta": {
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal"
      }
    }
  }
}
