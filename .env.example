# Android release signing: copy to .env and set the required vars.
# ensure-android-keystore-props.sh uses these to create android/keystore.properties.
# Optional: ANDROID_KEYSTORE_PATH (default: .backup/orbyt-upload-key.keystore)

ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=
# ANDROID_KEYSTORE_PATH=.backup/orbyt-upload-key.keystore
